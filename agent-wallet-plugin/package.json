{
  "name": "mm-plugin-cargo-notes",
  "version": "0.1.0",
  "description": "CargoFlow cargo notes for the MetaMask Agent Wallet CLI (mm): evidence-aware trade-finance credit trading on Monad with agent-safe limits",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "oclif-plugin",
    "metamask",
    "agent-wallet",
    "monad",
    "trade-finance"
  ],
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && oclif manifest",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "cargo": {
        "description": "Trade CargoFlow cargo notes (tokenised trade-finance credit) on Monad, gated by sensor evidence"
      }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": ">=6.2.0",
    "capabilities": [],
    "commands": [
      { "id": "cargo:list", "capabilities": [], "dataAccess": [], "targetChains": [10143] },
      { "id": "cargo:quote", "capabilities": ["wallet-read"], "dataAccess": [], "targetChains": [10143] },
      { "id": "cargo:buy", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts", "balances"], "targetChains": [10143] },
      { "id": "cargo:bid", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts", "balances"], "targetChains": [10143] },
      { "id": "cargo:cancel-bid", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts"], "targetChains": [10143] },
      { "id": "cargo:scan", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts", "balances"], "targetChains": [10143] }
    ]
  },
  "peerDependencies": {
    "@metamask/agent-wallet": "^6.2.0 || ^7.0.0"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@metamask/agent-wallet": "^7.2.0",
    "@types/node": "^22",
    "oclif": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
